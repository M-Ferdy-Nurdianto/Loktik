# SUPABASE CREDENTIALS FOR LOKTIK
# Dapatkan kredensial ini dari Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# URL Server WhatsApp Bot (server/wa-bot.cjs)
# - Local PC:   http://localhost:5000
# - Akses HP (LAN): http://192.168.x.x:5000 (ganti dengan IP PC)
# - Production (Vercel): https://LOKTIK-WA-BOT.onrender.com
VITE_WA_BOT_URL=http://localhost:5000

# Provider WA: 'wweb' = whatsapp-web.js bot (default), 'fonnte' = Vercel serverless Fonnte
VITE_WA_PROVIDER=wweb
